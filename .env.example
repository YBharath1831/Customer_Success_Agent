# Copy this file to .env and replace the placeholder API key.
# Never commit the real .env file.

# OpenRouter
OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=meta-llama/llama-3.1-8b-instruct

# Local embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval and chunking experiments
CHUNK_MAX_CHARACTERS=1200
CHUNK_OVERLAP_CHARACTERS=160
RETRIEVAL_TOP_K=5
MINIMUM_GROUNDING_OVERLAP=0.15

# Routing policy
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_THRESHOLD=0.40
KILL_SWITCH=false

# Provider resilience
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Runtime paths, resolved from the project root
DATA_DIR=./data
STORAGE_DIR=./storage
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
EVALUATION_RESULTS_DIR=./evaluation/results

# Logging
LOG_LEVEL=INFO
